# Dependencies and local environments
node_modules/
.venv/
venv/
env/

# Build output and distributable archives
dist/
build/
release/
*.tsbuildinfo
*.tar.gz
*.tgz

# Secrets and local credentials
.env
.env.*
!.env.example
!.env.*.example
admin-access.txt
*.pem
*.key
*.p12
*.pfx

# Runtime data, uploads and backups
/data/*
!/data/.gitkeep
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql
backups/
uploads/

# Test results, coverage and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage/
pytest-results.xml
junit*.xml
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Publish only reviewed README assets, never raw test artifacts
/artifacts/*
!/artifacts/readme/
/artifacts/readme/*
!/artifacts/readme/*.png
!/artifacts/readme/*.webp
!/artifacts/readme/*.jpg
!/artifacts/readme/*.svg
!/artifacts/readme/*.md

# Logs, temporary files and editor state
*.log
*.pid
tmp/
temp/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.agents/
.codex/
