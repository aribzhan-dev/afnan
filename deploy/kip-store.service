[Unit]
Description=KIP electrical store
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=kip-store
Group=kip-store
WorkingDirectory=/srv/kip-store/app
EnvironmentFile=/etc/kip-store/kip-store.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/kip-store/app/.venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8105 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --limit-concurrency 32
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kip-store
MemoryAccounting=true
MemoryHigh=256M
MemoryMax=384M
CPUAccounting=true
CPUQuota=50%
Nice=10
TasksMax=64

[Install]
WantedBy=multi-user.target
