server {
    listen 80;
    server_name shop.example.kz;
    location /.well-known/acme-challenge/ {
        root /var/www/kip-store-acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name shop.example.kz;
    ssl_certificate /etc/letsencrypt/live/shop.example.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.kz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;
    access_log /var/log/nginx/kip-store.access.log;
    error_log /var/log/nginx/kip-store.error.log;

    location / {
        proxy_pass http://127.0.0.1:8105;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
